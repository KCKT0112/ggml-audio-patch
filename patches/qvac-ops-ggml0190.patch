diff --git a/src/ggml-vulkan/vulkan-shaders/affine_prelu.comp b/src/ggml-vulkan/vulkan-shaders/affine_prelu.comp
new file mode 100644
index 0000000..263aa3b
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/affine_prelu.comp
@@ -0,0 +1,40 @@
+#version 450
+
+#include "types.glsl"
+
+// Fused affine + per-channel PReLU (LavaSR denoiser), scalar op order:
+// out = x*aw[f,c] + ab[f,c] + (max(x,0) + slope[c]*min(x,0)).  One thread per element.
+layout (push_constant) uniform parameter
+{
+    uint ne;   // total dst elements
+    uint F;    // ne0
+    uint FT;   // ne0*ne1 (plane size)
+    uint C;    // ne2 (channels)
+} p;
+
+layout (binding = 0) readonly buffer X  {float data_x[];};
+layout (binding = 1) readonly buffer AW {float data_aw[];};
+layout (binding = 2) readonly buffer AB {float data_ab[];};
+layout (binding = 3) readonly buffer SL {float data_sl[];};
+layout (binding = 4) writeonly buffer D {float data_d[];};
+
+layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;
+    if (idx >= p.ne) {
+        return;
+    }
+
+    const uint pl = idx / p.FT;        // plane = c + C*b
+    const uint i  = idx - pl * p.FT;   // f + F*t
+    const uint c  = pl % p.C;
+    const uint f  = i % p.F;
+
+    const float xv = data_x[idx];
+    const float r  = max(xv, 0.0f);
+    const float n  = xv - r;
+    const float pr = r + data_sl[c] * n;
+    const float a  = xv * data_aw[c * p.F + f] + data_ab[c * p.F + f];
+    data_d[idx] = a + pr;
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/channel_shuffle.comp b/src/ggml-vulkan/vulkan-shaders/channel_shuffle.comp
new file mode 100644
index 0000000..941fa6c
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/channel_shuffle.comp
@@ -0,0 +1,33 @@
+#version 450
+
+#include "types.glsl"
+
+// Channel shuffle (G groups) along ne2 (PyTorch, LavaSR denoiser): output plane
+// c' copies input plane (c'%G)*(C/G) + c'/G.  One thread per dst element (gather).
+layout (push_constant) uniform parameter
+{
+    uint ne;   // total dst elements
+    uint FT;   // ne0*ne1 (plane size)
+    uint C;    // ne2 (channels)
+    uint G;    // groups
+} p;
+
+layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
+layout (binding = 1) writeonly buffer D {D_TYPE data_d[];};
+
+layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;
+    if (idx >= p.ne) {
+        return;
+    }
+
+    const uint pl = idx / p.FT;        // output plane = c' + C*b
+    const uint ft = idx - pl * p.FT;
+    const uint c  = pl % p.C;
+    const uint b  = pl / p.C;
+    const uint ic = (c % p.G) * (p.C / p.G) + c / p.G;
+
+    data_d[idx] = D_TYPE(data_a[(ic + p.C * b) * p.FT + ft]);
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/gru.comp b/src/ggml-vulkan/vulkan-shaders/gru.comp
new file mode 100644
index 0000000..1bba77d
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/gru.comp
@@ -0,0 +1,77 @@
+#version 450
+
+#include "types.glsl"
+
+// Fused batched GRU (PyTorch: gate order r,z,n, reset on hh new-gate, h0=0).
+// whh [H,3H], gi [3H,B,L], bhh [3H] -> dst [H,B,L]; 128-lane WG packs 128/H batch elems.
+#define GRU_MAX_H 128
+
+layout (push_constant) uniform parameter
+{
+    uint H;
+    uint B;
+    uint L;
+    uint reverse;
+} p;
+
+layout (binding = 0) readonly buffer W {float data_whh[];};
+layout (binding = 1) readonly buffer G {float data_gi[];};
+layout (binding = 2) readonly buffer BH {float data_bhh[];};
+layout (binding = 3) writeonly buffer D {float data_d[];};
+
+layout(local_size_x = GRU_MAX_H, local_size_y = 1, local_size_z = 1) in;
+
+shared float h_l[GRU_MAX_H];        // flat, slot-major: h_l[b_local*H + j] == h_l[lane]
+shared float gh_l[3 * GRU_MAX_H];   // flat: gh_l[b_local*3H + g]
+
+void main() {
+    const uint lane    = gl_LocalInvocationID.x;
+    const uint PB      = GRU_MAX_H / p.H;                   // batch elems per WG (uniform)
+    const uint b_local = lane / p.H;                        // slot in this WG
+    const uint j       = lane - b_local * p.H;              // hidden unit
+    const uint b       = gl_WorkGroupID.y * PB + b_local;   // global batch element
+    const uint H3      = 3u * p.H;
+    const uint hbase   = b_local * p.H;                     // == lane - j
+    const uint gbase   = b_local * H3;
+
+    // Ragged (128 % H != 0) and batch-tail lanes idle but run every barrier.
+    const bool lane_live = (b_local < PB) && (b < p.B);
+
+    if (lane_live) {
+        h_l[lane] = 0.0f;                                   // zero initial state
+    }
+    barrier();
+
+    // barrier()s stay in uniform control flow: every lane runs all L steps.
+    for (uint s = 0u; s < p.L; ++s) {
+        const uint t       = (p.reverse != 0u) ? (p.L - 1u - s) : s;
+        const uint gi_base = H3 * b + H3 * p.B * t;
+
+        // pass 1: gh[g] = sum_k whh[k,g]*h[k] + bhh[g] for this lane's 3 gate rows
+        // (CPU reference order: bias added after the accumulation).
+        if (lane_live) {
+            for (uint gg = 0u; gg < 3u; ++gg) {
+                const uint g     = gg * p.H + j;
+                const uint wbase = p.H * g;
+                float acc = 0.0f;
+                for (uint k = 0u; k < p.H; ++k) {
+                    acc += data_whh[wbase + k] * h_l[hbase + k];
+                }
+                gh_l[gbase + g] = acc + data_bhh[g];
+            }
+        }
+        barrier();
+
+        // pass 2: gates + state update (each lane touches only h_l[lane]).
+        // exp/tanh args saturated: some mobile drivers NaN on exp overflow (>~88.7) not +inf; clamps bit-equal in fp32.
+        if (lane_live) {
+            const float r  = 1.0f / (1.0f + exp(min(-(data_gi[gi_base + j] + gh_l[gbase + j]), 88.0f)));
+            const float z  = 1.0f / (1.0f + exp(min(-(data_gi[gi_base + p.H + j] + gh_l[gbase + p.H + j]), 88.0f)));
+            const float nc = tanh(clamp(data_gi[gi_base + 2u * p.H + j] + r * gh_l[gbase + 2u * p.H + j], -15.0f, 15.0f));
+            const float hn = nc + z * (h_l[lane] - nc);
+            data_d[p.H * b + p.H * p.B * t + j] = hn;
+            h_l[lane] = hn;
+        }
+        barrier();
+    }
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/gru_small.comp b/src/ggml-vulkan/vulkan-shaders/gru_small.comp
new file mode 100644
index 0000000..1d90032
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/gru_small.comp
@@ -0,0 +1,77 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+
+#include "types.glsl"
+
+// Small-H fused GRU compiled per exact H (H_C; host selects p.H == H_C); fp op order matches
+// CPU reference / gru.comp exactly. whh [H,3H], gi [3H,B,L], bhh [3H] -> dst [H,B,L].
+#define WG_SIZE 128
+
+layout (push_constant) uniform parameter
+{
+    uint H;
+    uint B;
+    uint L;
+    uint reverse;
+} p;
+
+layout (binding = 0) readonly buffer W {float data_whh[];};
+layout (binding = 1) readonly buffer G {float data_gi[];};
+layout (binding = 2) readonly buffer BH {float data_bhh[];};
+layout (binding = 3) writeonly buffer D {float data_d[];};
+
+layout(local_size_x = WG_SIZE, local_size_y = 1, local_size_z = 1) in;
+
+shared float w_sh[H_C * 3 * H_C];   // whh, k-major per gate row
+shared float b_sh[3 * H_C];         // bhh
+
+void main() {
+    const uint lane = gl_LocalInvocationID.x;
+    const uint b    = gl_WorkGroupID.y * WG_SIZE + lane;    // global batch element
+    const uint H3   = 3u * H_C;
+
+    for (uint i = lane; i < H_C * H3; i += WG_SIZE) {
+        w_sh[i] = data_whh[i];
+    }
+    if (lane < H3) {
+        b_sh[lane] = data_bhh[lane];
+    }
+    barrier();
+
+    if (b >= p.B) {
+        return;                                             // after the only barrier
+    }
+
+    float h[H_C];
+    float gh[3 * H_C];
+    [[unroll]] for (uint j = 0u; j < H_C; ++j) {
+        h[j] = 0.0f;                                        // zero initial state
+    }
+
+    for (uint s = 0u; s < p.L; ++s) {
+        const uint t       = (p.reverse != 0u) ? (p.L - 1u - s) : s;
+        const uint gi_base = H3 * b + H3 * p.B * t;
+
+        // gh[g] = sum_k whh[k,g]*h[k] + bhh[g] (bias after accumulation, CPU order).
+        [[unroll]] for (uint g = 0u; g < 3u * H_C; ++g) {
+            float acc = 0.0f;
+            [[unroll]] for (uint k = 0u; k < H_C; ++k) {
+                acc += w_sh[H_C * g + k] * h[k];
+            }
+            gh[g] = acc + b_sh[g];
+        }
+
+        // gates + state update; exp/tanh args saturated (mobile drivers NaN on
+        // exp overflow instead of +inf); clamps bit-equivalent in fp32.
+        const uint obase = H_C * b + H_C * p.B * t;
+        [[unroll]] for (uint j = 0u; j < H_C; ++j) {
+            const float r  = 1.0f / (1.0f + exp(min(-(data_gi[gi_base + j] + gh[j]), 88.0f)));
+            const float z  = 1.0f / (1.0f + exp(min(-(data_gi[gi_base + H_C + j] + gh[H_C + j]), 88.0f)));
+            const float nc = tanh(clamp(data_gi[gi_base + 2u * H_C + j] + r * gh[2u * H_C + j], -15.0f, 15.0f));
+            const float hn = nc + z * (h[j] - nc);
+            data_d[obase + j] = hn;
+            h[j] = hn;
+        }
+    }
+}
