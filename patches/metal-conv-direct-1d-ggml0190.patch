+    int32_t OL;
+    int32_t IC;
+    int32_t OC;
+    int32_t K;
+    int32_t pad;
+    int32_t dil;
+    int32_t has_bias;
+    int32_t has_res;
+    float   slope;
+    float   in_scale;
