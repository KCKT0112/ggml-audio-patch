+// Fused HiFiGAN stride-1 direct convolution.  The matrix variant computes an
+// [OC_TILE x T_TILE] output tile as W[OC,K*IC] * implicit_im2col(X)[K*IC,T].
+// One threadgroup shares every gathered X value across its output-channel tile,
+// avoiding both the multi-gigabyte im2col traffic and the standalone bias,
+// residual, scale and leaky-ReLU kernels in the original graph.
+template <ushort OC_TILE, ushort T_TILE, ushort K_TILE, ushort NSG>
+kernel void kernel_conv_direct_1d_matrix(
+        constant ggml_metal_kargs_conv_direct_1d & args,
+        device const float * w,
+        device const float * x,
+        device const float * bias,
+        device const float * res,
+        device       float * dst,
+        threadgroup  float * shmem [[threadgroup(0)]],
+        uint2 tgpig [[threadgroup_position_in_grid]],
+        ushort tid [[thread_index_in_threadgroup]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    constexpr ushort NTH = NSG*32;
+    constexpr ushort ROW_BLOCKS = OC_TILE/(NSG*8);
+    constexpr ushort COL_BLOCKS = T_TILE/8;
+
+    const uint t0  = tgpig.x*T_TILE;
+    const uint oc0 = tgpig.y*OC_TILE;
+    const uint KIC = args.K*args.IC;
+
+    threadgroup float * sa = shmem;
+    threadgroup float * sb = sa + OC_TILE*K_TILE;
+    // Once the K loop completes sa/sb are dead.  Reuse that storage for the
+    // accumulator spill instead of reserving a disjoint output tile; this
+    // cuts the 64x64 variant from 20 KiB to 16 KiB of shared memory.
+    threadgroup float * sc = shmem;
+
+    simdgroup_float8x8 acc[ROW_BLOCKS*COL_BLOCKS];
+    for (ushort i = 0; i < ROW_BLOCKS*COL_BLOCKS; ++i) {
+        acc[i] = make_filled_simdgroup_matrix<float, 8>(0.0f);
+    }
+
+    for (uint k0 = 0; k0 < KIC; k0 += K_TILE) {
+        // W tile: [OC_TILE, K_TILE], contiguous in flattened (ic, kw) order.
+        for (uint idx = tid; idx < OC_TILE*K_TILE; idx += NTH) {
+            const uint o = idx/K_TILE;
+            const uint kk = idx - o*K_TILE;
+            const uint oc = oc0 + o;
+            const uint q = k0 + kk;
+            sa[idx] = oc < (uint)args.OC && q < KIC ? w[oc*KIC + q] : 0.0f;
+        }
+
+        // Implicit im2col tile: [K_TILE, T_TILE].  Threads walk contiguous time
+        // positions, so every (ic,kw) input row is a coalesced read.
+        for (uint idx = tid; idx < K_TILE*T_TILE; idx += NTH) {
+            const uint kk = idx/T_TILE;
+            const uint jt = idx - kk*T_TILE;
+            const uint q = k0 + kk;
+            const uint t = t0 + jt;
+            float v = 0.0f;
+            if (q < KIC && t < (uint)args.OL) {
+                const uint ic = q/(uint)args.K;
+                const uint kw = q - ic*(uint)args.K;
+                const int it = (int)t + (int)kw*args.dil - args.pad;
+                if (it >= 0 && it < args.T) {
+                    v = x[ic*(uint)args.T + (uint)it] * args.in_scale;
+                    if (args.in_slope != 0.0f && v < 0.0f) {
+                        v *= args.in_slope;
+                    }
+                }
+            }
+            sb[idx] = v;
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        for (ushort kb = 0; kb < K_TILE/8; ++kb) {
+            simdgroup_float8x8 ma[ROW_BLOCKS];
+            simdgroup_float8x8 mb[COL_BLOCKS];
+            for (ushort r = 0; r < ROW_BLOCKS; ++r) {
+                simdgroup_load(ma[r], sa + (sgitg*ROW_BLOCKS + r)*8*K_TILE + kb*8,
+                               K_TILE, 0, false);
+            }
+            for (ushort c = 0; c < COL_BLOCKS; ++c) {
+                simdgroup_load(mb[c], sb + kb*8*T_TILE + c*8, T_TILE, 0, false);
+            }
+            for (ushort r = 0; r < ROW_BLOCKS; ++r) {
+                for (ushort c = 0; c < COL_BLOCKS; ++c) {
+                    const ushort i = r*COL_BLOCKS + c;
+                    simdgroup_multiply_accumulate(acc[i], ma[r], mb[c], acc[i]);
+                }
+            }
+        }
+
+        // sa/sb are reused by the next K tile; every simdgroup must finish
+        // consuming them before any thread starts overwriting the buffers.
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+
+    for (ushort r = 0; r < ROW_BLOCKS; ++r) {
+        for (ushort c = 0; c < COL_BLOCKS; ++c) {
+            simdgroup_store(acc[r*COL_BLOCKS + c],
+                            sc + (sgitg*ROW_BLOCKS + r)*8*T_TILE + c*8,
+                            T_TILE, 0, false);
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    // Fused epilogue and guarded edge store.
+    for (uint idx = tid; idx < OC_TILE*T_TILE; idx += NTH) {
+        const uint o = idx/T_TILE;
+        const uint jt = idx - o*T_TILE;
+        const uint oc = oc0 + o;
+        const uint t = t0 + jt;
+        if (oc < (uint)args.OC && t < (uint)args.OL) {
+            const uint di = oc*(uint)args.OL + t;
+            float v = sc[idx];
+            if (args.has_bias) v += bias[oc];
+            if (args.has_res)  v += res[di];
+            if (args.slope != 0.0f && v < 0.0f) v *= args.slope;
+            dst[di] = v;
+        }
+    }
+}
