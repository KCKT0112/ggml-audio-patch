+// Narrow-output path (conv_post is OC=1): one coalesced thread per time
+// position avoids paying for seven empty rows of an 8x8 matrix tile.
+kernel void kernel_conv_direct_1d_f32_scalar(
+        constant ggml_metal_kargs_conv_direct_1d & args,
+        device const float * w,
+        device const float * x,
+        device const float * bias,
+        device const float * res,
+        device       float * dst,
+        uint2 tgpig [[threadgroup_position_in_grid]],
+        ushort tid [[thread_index_in_threadgroup]]) {
+    const uint t = tgpig.x*256 + tid;
+    const uint oc = tgpig.y;
+    if (t >= (uint)args.OL || oc >= (uint)args.OC) return;
+
+    float sum = 0.0f;
+    for (uint ic = 0; ic < (uint)args.IC; ++ic) {
+        for (uint kw = 0; kw < (uint)args.K; ++kw) {
+            const int it = (int)t + (int)kw*args.dil - args.pad;
+            if (it >= 0 && it < args.T) {
+                float v = x[ic*(uint)args.T + (uint)it] * args.in_scale;
+                if (args.in_slope != 0.0f && v < 0.0f) v *= args.in_slope;
+                sum = fma(w[(oc*(uint)args.IC + ic)*(uint)args.K + kw], v, sum);
+            }
+        }
+    }
+    const uint di = oc*(uint)args.OL + t;
+    if (args.has_bias) sum += bias[oc];
+    if (args.has_res)  sum += res[di];
+    if (args.slope != 0.0f && sum < 0.0f) sum *= args.slope;
+    dst[di] = sum;
+}
