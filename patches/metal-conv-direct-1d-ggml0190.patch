+int ggml_metal_op_conv_direct_1d(ggml_metal_op_t ctx, int idx) {
+    ggml_tensor * op = ctx->node(idx);
+
+    ggml_metal_library_t lib = ctx->lib;
+    ggml_metal_encoder_t enc = ctx->enc;
+
+    const int32_t * params = (const int32_t *) op->op_params;
+    float slope;
+    float in_scale;
+    float in_slope;
+    memcpy(&slope,    &params[2], sizeof(float));
+    memcpy(&in_scale, &params[4], sizeof(float));
+    memcpy(&in_slope, &params[5], sizeof(float));
+
+    ggml_metal_kargs_conv_direct_1d args = {
+        /*.T         =*/ (int32_t) op->src[1]->ne[0],
+        /*.OL        =*/ (int32_t) op->ne[0],
+        /*.IC        =*/ (int32_t) op->src[1]->ne[1],
+        /*.OC        =*/ (int32_t) op->ne[1],
+        /*.K         =*/ (int32_t) op->src[0]->ne[0],
+        /*.pad       =*/ params[0],
+        /*.dil       =*/ params[1],
+        /*.has_bias  =*/ params[3],
+        /*.has_res   =*/ params[6],
+        /*.slope     =*/ slope,
+        /*.in_scale  =*/ in_scale,
+        /*.in_slope  =*/ in_slope,
+    };
+
+    auto pipeline = ggml_metal_library_get_pipeline_conv_direct_1d(lib, op);
+
+    ggml_metal_encoder_set_pipeline(enc, pipeline);
+    ggml_metal_encoder_set_bytes   (enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[0]), 1);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[1]), 2);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[2] ? op->src[2] : op->src[0]), 3);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[3] ? op->src[3] : op->src[0]), 4);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op), 5);
+
+    if (args.OC < 8) {
+        constexpr uint64_t nth = 256;
+        ggml_metal_encoder_dispatch_threadgroups(enc, (args.OL + nth - 1)/nth, args.OC, 1,
+                                                  nth, 1, 1);
+    } else {
+        constexpr uint64_t tile_k = 8;
+        const uint64_t tile_oc = args.OC <= 16 ? 16 : (args.OC <= 32 ? 32 : 64);
+        constexpr uint64_t tile_t = 64;
+        const uint64_t nth = (tile_oc/8)*32;
+        const size_t stage_elems = tile_oc*tile_k + tile_k*tile_t;
+        const size_t spill_elems = tile_oc*tile_t;
+        const size_t smem = std::max(stage_elems, spill_elems)*sizeof(float);
+        ggml_metal_encoder_set_threadgroup_memory_size(enc, smem, 0);
+        ggml_metal_encoder_dispatch_threadgroups(enc,
+                                                  (args.OL + tile_t - 1)/tile_t,
+                                                  (args.OC + tile_oc - 1)/tile_oc, 1,
+                                                  nth, 1, 1);
+    }
+
+    return 1;
+}
