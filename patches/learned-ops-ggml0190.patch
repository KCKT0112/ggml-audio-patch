+// learned-ops patch: fused add + leaky ReLU (HiFiGAN vocoder).
+//   dst = lrelu(a + b, slope)  in one pass, bit-identical to
+//   ggml_add followed by ggml_leaky_relu (same expression as
+//   ggml_vec_leaky_relu_f32, applied to the fused sum).
+//   a: [T, C] contiguous F32; b: [1, C] row-broadcast bias or [T, C]
+//   elementwise operand, contiguous F32.
+void ggml_compute_forward_add_leaky_relu(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * a = dst->src[0];   // [T, C]
+    const ggml_tensor * b = dst->src[1];   // [1, C] or [T, C]
+
+    GGML_ASSERT(a->type == GGML_TYPE_F32);
+    GGML_ASSERT(b->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(ggml_is_contiguous(b));
+    GGML_ASSERT(ggml_is_contiguous(dst));
+    GGML_ASSERT(a->ne[2] == 1 && a->ne[3] == 1);
+    GGML_ASSERT(dst->ne[0] == a->ne[0] && dst->ne[1] == a->ne[1]);
+    GGML_ASSERT(a->ne[1] == b->ne[1]);
+    GGML_ASSERT(b->ne[0] == 1 || b->ne[0] == a->ne[0]);
+
+    const int64_t T = a->ne[0];
+    const int64_t C = a->ne[1];
+
+    float slope;
+    memcpy(&slope, dst->op_params, sizeof(float));
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const float * a_data = (const float *) a->data;
+    const float * b_data = (const float *) b->data;
+          float * y_data = (float *)       dst->data;
+
+    const bool elementwise = b->ne[0] != 1;
+
+    if (C >= nth) {
+        // Fast path: stripe over channels.  The bias value stays in a
+        // register and the inner loop walks contiguous t for both inputs and
+        // the output (auto-vectorizable: two selects + mul + add).
+        for (int64_t c = ith; c < C; c += nth) {
+            const float * ap = a_data + c * T;
+            const float * bp = b_data + (elementwise ? c * T : c);
+                  float * yp = y_data + c * T;
+            if (elementwise) {
+                for (int64_t t = 0; t < T; ++t) {
+                    const float v = ap[t] + bp[t];
+                    yp[t] = (v > 0.f ? v : 0.f) + slope * (v < 0.f ? v : 0.f);
+                }
+            } else {
+                const float bv = bp[0];
+                for (int64_t t = 0; t < T; ++t) {
+                    const float v = ap[t] + bv;
+                    yp[t] = (v > 0.f ? v : 0.f) + slope * (v < 0.f ? v : 0.f);
+                }
+            }
+        }
+    } else {
+        // Few channels (e.g. C < n_threads): split the flattened element
+        // range instead, aligned to row boundaries so the broadcast bias
+        // index only changes between rows.
+        const int64_t total = C * T;
+        const int64_t per   = (total + nth - 1) / nth;
+        const int64_t start = (int64_t) ith * per;
+        const int64_t stop  = MIN(start + per, total);
+        int64_t c = start / T;
+        int64_t t = start - c * T;
+        for (int64_t i = start; i < stop; /* advanced below */) {
+            const int64_t chunk = MIN(stop - i, T - t);
+            const float * ap = a_data + c * T + t;
+            const float * bp = b_data + (elementwise ? c * T + t : c);
+                  float * yp = y_data + c * T + t;
+            if (elementwise) {
+                for (int64_t k = 0; k < chunk; ++k) {
+                    const float v = ap[k] + bp[k];
+                    yp[k] = (v > 0.f ? v : 0.f) + slope * (v < 0.f ? v : 0.f);
+                }
+            } else {
+                const float bv = bp[0];
+                for (int64_t k = 0; k < chunk; ++k) {
+                    const float v = ap[k] + bv;
+                    yp[k] = (v > 0.f ? v : 0.f) + slope * (v < 0.f ? v : 0.f);
+                }
+            }
+            i += chunk;
+            t += chunk;
+            if (t == T) { t = 0; ++c; }
+        }
+    }
+}
